{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gitflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"rules": [
		{
			"type": "Data",
			"globs": [
				"**/*.png"
			],
			"fallthrough": true
		}
	],
	"workers_dev": true,
	"routes": [
		{
			"pattern": "git.beenex.company",
			"custom_domain": true
		}
	],
	// ─── Git Repository Storage ─────────────────────────────────
	// Cloudflare Artifacts: Git-native storage engine (Zig/WASM)
	// Handles Smart HTTP v2 protocol, packfiles, ref management
	"artifacts": [
		{
			"binding": "REPOS",
			"namespace": "gitflare-repos"
		}
	],
	// ─── Metadata Database ──────────────────────────────────────
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gitflare-db",
			"database_id": "4c45888c-4159-4f7a-9733-afedf181cf25",
			"migrations_dir": "migrations"
		}
	],
	// ─── Large File / LFS / Build Artifact Storage ──────────────
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "gitflare-storage"
		}
	],
	// ─── Cache Layer ────────────────────────────────────────────
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "4307512814534b69a9ef37a04522f4ca"
		}
	],
	// ─── CI/CD Job Queue ────────────────────────────────────────
	"queues": {
		"producers": [
			{
				"binding": "CI_QUEUE",
				"queue": "gitflare-ci-jobs"
			},
			{
				"binding": "DEPLOY_QUEUE",
				"queue": "gitflare-deploy-jobs"
			},
			{
				"binding": "MIRROR_QUEUE",
				"queue": "gitflare-mirror-sync"
			}
		],
		"consumers": [
			{
				"queue": "gitflare-ci-jobs",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "gitflare-ci-dlq"
			},
			{
				"queue": "gitflare-deploy-jobs",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "gitflare-deploy-dlq"
			},
			{
				// GitHub mirror pushes (lib/github-mirror.ts). Queue consumers get
				// minutes of wall clock vs ~30s for waitUntil — needed for big packs.
				// max_concurrency 1: no two syncs race on the same GitHub refs.
				"queue": "gitflare-mirror-sync",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "gitflare-mirror-dlq"
			}
		]
	},
	// ─── Scheduled Maintenance ──────────────────────────────────
	// src/lib/maintenance.ts: fail CI runs/deployments stuck past their
	// deadline, purge expired sessions.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	// ─── Durable Objects (Coordination) ─────────────────────────
	"durable_objects": {
		"bindings": [
			{
				// Per-repo push locks (src/do/repo-coordinator.ts)
				"name": "REPO_COORDINATOR",
				"class_name": "RepoCoordinator"
			},
			{
				// Per-repo merge queue (src/do/ticket-queue.ts)
				"name": "TICKET_QUEUE",
				"class_name": "TicketQueue"
			}
		]
	},
	// ─── Observability ──────────────────────────────────────────
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// ─── DO Migrations ──────────────────────────────────────────
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RepoCoordinator",
				"CISession"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"TicketQueue"
			]
		},
		{
			// CISession (WebSocket log streaming) was never wired to a route
			// or written to; removed in Phase Final cleanup. Deleting a class
			// discards its storage — it never held any.
			"tag": "v3",
			"deleted_classes": [
				"CISession"
			]
		}
	],
	// ─── Secrets ────────────────────────────────────────────────
	// Set with `wrangler secret put <NAME>` (locally: .dev.vars, see
	// .dev.vars.example). Required:
	//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ENCRYPTION_KEY, SESSION_SECRET,
	//   RUNNER_URL, RUNNER_SECRET, ADMIN_API_KEY
	// Optional: COOLIFY_BASE_URL, COOLIFY_API_KEY, ALLOWED_DOMAINS, ADMIN_EMAILS,
	//   R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY (R2 API token, Object Read & Write on
	//   gitflare-storage → enables presigned LFS transfers)
	//
	// Deliberately NOT declared via `"secrets": { "required": [...] }`: that
	// makes wrangler drop every .dev.vars entry not on the list in local dev
	// (so the optional ones above would silently vanish) and fail deploys on
	// any missing secret. The deploy workflow checks the critical ones instead.
	// ─── Environment Variables ──────────────────────────────────
	"vars": {
		"GITFLARE_VERSION": "1.1.8",
		// Git LFS (src/api/lfs.ts). Objects live in the STORAGE bucket under lfs/<repoId>/<oid>.
		// Transfer mode is "presigned" when the R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY secrets
		// are set (bytes go straight to R2, objects up to 5 GiB) and "proxy" otherwise (bytes
		// stream through the Worker, capped by the zone's request-body limit: 100 MB on Free/Pro).
		// LFS_MAX_OBJECT_BYTES overrides the mode's default cap; a repo can lower it further.
		"LFS_URL_TTL_SECONDS": "900",
		"R2_BUCKET_NAME": "gitflare-storage",
		"MAX_CI_DURATION_MS": "900000",
		"APP_URL": "https://git.beenex.company",
		"CLOUDFLARE_ACCOUNT_ID": "aed09ddf6077b29514def05ed3d5e699"
	}
}