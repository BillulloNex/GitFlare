{
	"name": "gitflare",
	"version": "1.1.2",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply gitflare-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply gitflare-db --remote",
		"db:migrations:list": "wrangler d1 migrations list gitflare-db --remote",
		"db:migrations:create": "wrangler d1 migrations create gitflare-db",
		"db:export:remote": "wrangler d1 export gitflare-db --remote --output=gitflare-db-backup.sql",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.0",
		"aws4fetch": "^1.0.20",
		"hono": "^4.7.0",
		"yaml": "^2.7.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.0",
		"@cloudflare/workers-types": "latest",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0",
		"wrangler": "^4.14.0"
	},
	"engines": {
		"node": ">=22"
	}
}
